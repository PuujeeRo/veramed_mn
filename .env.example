# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# With everything below left blank the public site still runs, showing the
# sample content in supabase/seed.json. Signing in and the dashboard need a
# real Supabase project.
#
# Use a NEW Supabase project for this site. Do not point it at another
# app's database: scripts/apply-schema.mjs creates tables named brands,
# products, profiles, … and would collide with anything already there.

# --- Supabase (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — safe in the browser, respects RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key — SERVER ONLY, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection, used only by scripts/*.mjs ---
# (Dashboard → Settings → Database → Connection string.) The pooled URL is
# preferred when set; the direct host is IPv6-only on many projects.
DATABASE_URL=
DATABASE_POOL_URL=

# --- Manager account, created by `node scripts/seed-auth.mjs` ---
# Password: at least 12 characters. There is no default and no public signup.
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
# Optional second account with the admin role.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Cloudinary image upload (optional) ---
# Unsigned upload preset. Left blank, image fields fall back to a plain
# "paste an image URL" input.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
